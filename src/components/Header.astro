---
import { SITE } from '../consts';
import type { Lang } from '../consts';
import { t, otherLang, langLabel } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const other = otherLang(lang);
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href={`/${lang}/`}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <path d="M7.8 6.9 16.2 11.1"/>
        <path d="M7.8 17.1 16.2 12.9"/>
        <circle cx="5"  cy="6"  r="2.8" fill="currentColor" stroke="none"/>
        <circle cx="5"  cy="18" r="2.8" fill="currentColor" stroke="none"/>
        <circle cx="19" cy="12" r="2.8" fill="currentColor" stroke="none"/>
      </svg>
      <span>{SITE.title}</span>
    </a>
    <nav>
      <a href={`/${lang}/`}>{tr('nav.posts')}</a>
      <a href={`/${lang}/categories/`}>{tr('nav.categories')}</a>
      <a href={`/${lang}/tags/`}>{tr('nav.tags')}</a>
      <a href={`/${other}/`}>{langLabel[other]}</a>
    </nav>
  </div>
</header>
