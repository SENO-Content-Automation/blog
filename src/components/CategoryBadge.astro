---
import { CATEGORIES, type CategorySlug } from '../categories';
import type { Lang } from '../consts';

interface Props { slug: CategorySlug; lang: Lang; link?: boolean }
const { slug, lang, link = true } = Astro.props;
const meta = CATEGORIES[slug];
---
{link ? (
  <a class="cat" href={`/${lang}/categories/${slug}/`}>{meta.label}</a>
) : (
  <span class="cat">{meta.label}</span>
)}
